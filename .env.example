# Express API
API_PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# Authentication stays off until credentials are added.
AUTH_ENABLED=false
MONGODB_URI=
MONGODB_DATABASE=ipdokan
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000
API_RESOURCE=http://localhost:4000/api
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=admin@example.com

# Optional local demo admin; never enable this in production.
DEMO_ADMIN_ENABLED=false
DEMO_ADMIN_EMAIL=demo-admin@example.com
DEMO_ADMIN_PASSWORD=
DEMO_ADMIN_NAME=Demo Admin

# Next.js browser requests
NEXT_PUBLIC_API_URL=http://localhost:4000
# ZiniPay (bKash/Nagad, BDT). When set, ZiniPay is used instead of Stripe.
ZINIPAY_API_KEY=
ZINIPAY_BASE_URL=https://api.zinipay.com
# Cryptomus (crypto, USD). Merchant UUID and the *payment* API key from Cryptomus merchant settings.
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_PAYMENT_KEY=
# MyProxyApi reseller API. Proxies from API products are ordered automatically after payment
# and paid for from your MyProxyApi deposit balance, so keep that balance topped up.
MYPROXYAPI_USERNAME=
MYPROXYAPI_SECRET=
# Optional: order for a MyProxyApi sub-user instead of your own reseller account.
MYPROXYAPI_USER_ID=
MYPROXYAPI_BASE_URL=https://reseller.myproxyapi.com/api/v1
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudinary (product images uploaded from the admin panel)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
