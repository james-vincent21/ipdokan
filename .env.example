# Express API
API_PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# Authentication stays off until credentials are added.
AUTH_ENABLED=false
MONGODB_URI=
MONGODB_DATABASE=ipdokan
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000
API_RESOURCE=http://localhost:4000/api
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=admin@example.com

# Optional local demo admin; never enable this in production.
DEMO_ADMIN_ENABLED=false
DEMO_ADMIN_EMAIL=demo-admin@example.com
DEMO_ADMIN_PASSWORD=
DEMO_ADMIN_NAME=Demo Admin

# Next.js browser requests
NEXT_PUBLIC_API_URL=http://localhost:4000
# ZiniPay (bKash/Nagad, BDT). When set, ZiniPay is used instead of Stripe.
ZINIPAY_API_KEY=
ZINIPAY_BASE_URL=https://api.zinipay.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
